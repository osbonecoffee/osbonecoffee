const SHEET_ORDERS='Orders',SHEET_CONTENT='Content';
function ss(){return SpreadsheetApp.getActiveSpreadsheet()}
function out(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
function setup(){const s=ss();let o=s.getSheetByName(SHEET_ORDERS);if(!o)o=s.insertSheet(SHEET_ORDERS);const oh=['id','createdAt','updatedAt','orderType','meja','namaPelanggan','total','status','bayar','metodeBayar','uangDiterima','kembalian','sumber','dibatalkan','itemsJson','diskonTipe','diskonNilai','diskon','totalBayar','dibayarAt'];if(o.getLastRow()===0)o.appendRow(oh);else{const h=o.getRange(1,1,1,o.getLastColumn()).getValues()[0];oh.forEach((x,i)=>{if(h[i]!==x)o.getRange(1,i+1).setValue(x)})}let c=s.getSheetByName(SHEET_CONTENT);if(!c)c=s.insertSheet(SHEET_CONTENT);if(c.getLastRow()===0)c.appendRow(['key','json','updatedAt'])}
function content_(){const sh=ss().getSheetByName(SHEET_CONTENT),rows=sh.getDataRange().getValues(),r=rows.slice(1).find(x=>x[0]==='osbone_content');return r?JSON.parse(r[1]):null}
function doGet(e){setup();const a=e.parameter.action||'';if(a==='getContent')return out({ok:true,content:content_()});if(a==='getOrders'){const sh=ss().getSheetByName(SHEET_ORDERS),rows=sh.getDataRange().getValues();const orders=rows.slice(1).filter(r=>r[0]).map(r=>({id:String(r[0]),createdAt:r[1] instanceof Date?r[1].toISOString():String(r[1]),updatedAt:r[2] instanceof Date?r[2].toISOString():String(r[2]),orderType:r[3],meja:r[4],namaPelanggan:r[5],total:Number(r[6])||0,status:r[7]||'baru',bayar:r[8]||'menunggu',metodeBayar:r[9]||'',uangDiterima:r[10]===''?null:Number(r[10])||0,kembalian:r[11]===''?null:Number(r[11])||0,sumber:r[12]||'',dibatalkan:r[13]===true||r[13]==='true',items:JSON.parse(r[14]||'[]'),diskonTipe:r[15]||'nominal',diskonNilai:Number(r[16])||0,diskon:Number(r[17])||0,totalBayar:r[18]===''?Number(r[6])||0:Number(r[18])||0,dibayarAt:r[19] instanceof Date?r[19].toISOString():r[19]||''}));return out({ok:true,orders})}return site_()}
function doPost(e){setup();let b={};try{b=JSON.parse(e.postData.contents||'{}')}catch(err){return out({ok:false,error:'JSON tidak valid'})}const a=b.action;if(a==='saveContent'){const sh=ss().getSheetByName(SHEET_CONTENT),rows=sh.getDataRange().getValues(),idx=rows.findIndex(x=>x[0]==='osbone_content'),now=new Date().toISOString(),json=typeof b.content==='string'?b.content:JSON.stringify(b.content);if(idx>0)sh.getRange(idx+1,2,1,2).setValues([[json,now]]);else sh.appendRow(['osbone_content',json,now]);return out({ok:true})}if(a==='addOrder'){const o=typeof b.order==='string'?JSON.parse(b.order):b.order;const sh=ss().getSheetByName(SHEET_ORDERS);const lock=LockService.getScriptLock();lock.waitLock(5000);try{if(sh.getDataRange().getValues().slice(1).some(r=>String(r[0])===String(o.id)))return out({ok:true,duplicate:true});sh.appendRow([o.id,o.createdAt,o.updatedAt,o.orderType||'take_away',o.meja||'',o.namaPelanggan||'',Number(o.total)||0,o.status||'baru',o.bayar||'menunggu',o.metodeBayar||'',o.uangDiterima??'',o.kembalian??'',o.sumber||'',!!o.dibatalkan,JSON.stringify(o.items||[]),o.diskonTipe||'nominal',Number(o.diskonNilai)||0,Number(o.diskon)||0,Number(o.totalBayar??o.total)||0,o.dibayarAt||'']);}finally{lock.releaseLock()}return out({ok:true})}if(a==='updateOrder'){const id=String(b.orderId),p=typeof b.patch==='string'?JSON.parse(b.patch):b.patch,sh=ss().getSheetByName(SHEET_ORDERS),rows=sh.getDataRange().getValues(),r=rows.findIndex(x=>String(x[0])===id);if(r<1)return out({ok:false,error:'Order tidak ditemukan'});const map={updatedAt:3,orderType:4,meja:5,namaPelanggan:6,total:7,status:8,bayar:9,metodeBayar:10,uangDiterima:11,kembalian:12,sumber:13,dibatalkan:14,diskonTipe:16,diskonNilai:17,diskon:18,totalBayar:19,dibayarAt:20};Object.keys(p).forEach(k=>{if(k==='items')sh.getRange(r+1,15).setValue(JSON.stringify(p[k]||[]));else if(map[k])sh.getRange(r+1,map[k]).setValue(p[k])});sh.getRange(r+1,3).setValue(new Date().toISOString());return out({ok:true})}return out({ok:false,error:'Action tidak dikenal'})}
function site_(){const c=content_();if(!c)return HtmlService.createHtmlOutput('<h2>Os Bone Coffee</h2><p>Website belum dikonfigurasi. Simpan konten melalui Website Builder terlebih dahulu.</p>').setTitle('Os Bone Coffee');const j=JSON.stringify(c).replace(/<\//g,'<\\\\/');return HtmlService.createHtmlOutput(`<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc_(c.brand?.name||'Os Bone Coffee')}</title><style>body{margin:0;background:#f5f1eb;color:#1a1a1a;font-family:Arial,sans-serif}main{max-width:1100px;margin:auto;padding:28px 20px}header{padding:18px 20px;border-bottom:1px solid #ddd;background:#f5f1eb;position:sticky;top:0}.brand{font-weight:800;font-size:22px}.hero{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;padding:80px 0}.hero h1{font-family:Georgia,serif;font-size:64px;line-height:.9}.hero img{width:100%;aspect-ratio:1/1.05;object-fit:cover;border-radius:28px}.menu{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{background:#fff;border:1px solid #eee;border-radius:20px;overflow:hidden}.card img{width:100%;aspect-ratio:4/2.8;object-fit:cover}.card div{padding:16px}.section{padding:80px 0}.muted{opacity:.65;line-height:1.7}@media(max-width:700px){.hero{grid-template-columns:1fr;padding:45px 0}.hero h1{font-size:48px}.menu{grid-template-columns:1fr 1fr}}@media(max-width:480px){.menu{grid-template-columns:1fr}}</style></head><body><header><main style="padding:0;display:flex;align-items:center;justify-content:space-between;gap:20px"><div class="brand">${esc_(c.brand?.name||'Os Bone Coffee')}</div><nav style="display:flex;gap:18px;overflow:auto;white-space:nowrap;font-size:12px">${(c.nav||[]).map(n=>`<a href="${esc_(n.href||'#')}" style="color:inherit;text-decoration:none;opacity:.75">${esc_(n.label||'')}</a>`).join('')}</nav></main></header><main><section class="hero"><div><div class="muted">${esc_(c.hero?.badgeText||'')}</div><h1>${esc_(c.hero?.titleLine1||'')} <span style="color:#8b5e3c">${esc_(c.hero?.titleHighlight||'')}</span><br>${esc_(c.hero?.titleLine2||'')}<br>${esc_(c.hero?.titleLine3||'')}</h1><p class="muted">${esc_(c.hero?.desc||'')}</p></div><img src="${esc_(c.hero?.image||'')}"></section><section class="section"><h2>${esc_(c.text?.menuHeading1||'Menu')} ${esc_(c.text?.menuHeading2||'')}</h2><div class="menu">${(c.menu?.items||[]).map(i=>`<article class="card"><img src="${esc_(i.image||'')}"><div><b>${esc_(i.name)}</b><p class="muted">${esc_(i.desc)}</p></div></article>`).join('')}</div></section><section class="section"><h2>${esc_(c.about?.heading1||'')} ${esc_(c.about?.heading2||'')}</h2><p class="muted">${esc_(c.about?.paragraph1||'')}</p><p class="muted">${esc_(c.about?.paragraph2||'')}</p></section></main><script>window.__CONTENT=${j};</script></body></html>`).setTitle(c.brand?.name||'Os Bone Coffee')}
function esc_(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}