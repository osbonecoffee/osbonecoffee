<!DOCTYPE html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Website Builder — Os Bone Coffee</title><script src="https://cdn.tailwindcss.com"></script><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><style>:root{--ink:#1A1A1A;--cream:#F5F1EB;--brown:#8B5E3C}*{box-sizing:border-box}body{background:#F7F5F1;color:var(--ink);font-family:Inter,sans-serif;margin:0}.serif{font-family:Fraunces,serif}.field{width:100%;border:1px solid rgba(26,26,26,.12);border-radius:12px;padding:10px 13px;font-size:13px;background:#fff;outline:none}.tab.active{background:var(--ink);color:#fff}</style></head><body><div id="root"></div><script src="app-config.js"></script><script src="shared.js"></script><script>
let content=normalizeContent(clone(DEFAULT_CONTENT)),saved=clone(content),tab='umum',dirty=false,syncState='checking';
const fields={
 umum:[
  ['brand.name','Nama Brand'],['brand.initial','Inisial Logo'],['brand.sub','Subjudul Logo'],['hero.badgeText','Badge / Jam Buka'],['hero.titleLine1','Hero Baris 1'],['hero.titleHighlight','Hero Highlight'],['hero.titleLine2','Hero Baris 2'],['hero.titleLine3','Hero Baris 3'],['hero.desc','Deskripsi Hero'],['hero.image','Gambar Hero'],['text.orderingOnlineLabel','Label Pemesanan Online'],['text.footerText','Footer ({year} dan {brand} tersedia)']
 ],
 tentang:[['about.eyebrow','Eyebrow'],['about.heading1','Judul 1'],['about.heading2','Judul 2'],['about.heading3','Judul 3'],['about.paragraph1','Paragraf 1'],['about.paragraph2','Paragraf 2'],['about.quote','Quote'],['about.quoteBy','Nama/atribusi quote']],
 galeri:[['text.galleryEyebrow','Eyebrow Galeri'],['text.galleryHeading1','Judul Galeri 1'],['text.galleryHeading2','Judul Galeri 2']],
 lokasi:[['text.locationEyebrow','Eyebrow Lokasi'],['location.heading1','Judul Lokasi 1'],['location.heading2','Judul Lokasi 2'],['location.address','Alamat'],['location.addressCity','Kota'],['location.addressNote','Catatan Alamat'],['location.hours1','Jam 1'],['location.hours2','Jam 2'],['location.instagram','Instagram'],['location.instagramLink','Link Instagram'],['location.waNumber','Nomor WhatsApp'],['location.mapsLink','Link Maps']]
};
function getp(o,p){return p.split('.').reduce((a,k)=>a?.[k],o)}
function setp(o,p,v){let a=p.split('.'),c=o;for(let i=0;i<a.length-1;i++)c=c[a[i]];c[a[a.length-1]]=v;dirty=true}
function preview(c){c=normalizeContent(c);return `<div class="rounded-[18px] bg-[var(--cream)] p-4"><div class="flex gap-3 items-center">${logo(c,'w-12 h-12')}<div><div class="font-bold serif">${esc(c.brand.name)}</div><div class="text-[10px] opacity-50">${esc(c.brand.sub)}</div></div></div><div class="mt-4 rounded-[16px] bg-white p-4"><div class="text-[10px] opacity-50">${esc(c.hero.badgeText)}</div><div class="serif text-[28px] leading-[.95] font-bold mt-2">${esc(c.hero.titleLine1)} <span class="text-[var(--brown)]">${esc(c.hero.titleHighlight)}</span><br>${esc(c.hero.titleLine2)}<br>${esc(c.hero.titleLine3)}</div></div></div>`}
function inputFor(path,label){const v=getp(content,path)||'';const area=['desc','paragraph','quote'].some(x=>path.includes(x));return `<label class="block"><span class="text-[11px] font-semibold opacity-60">${esc(label)}</span>${area?`<textarea class="field mt-1" rows="3" data-path="${path}">${esc(v)}</textarea>`:`<input class="field mt-1" data-path="${path}" value="${esc(v)}">`}</label>`}
function tabView(){
 if(tab==='tampilan')return `<div class="space-y-5"><div><div class="serif text-[20px] font-bold">Tata Letak</div><p class="text-[12px] opacity-60 mt-1">Atur ukuran dasar template tanpa mengubah struktur desain.</p></div><div class="grid md:grid-cols-2 gap-3">${[['design.containerWidth','Lebar Kontainer',900,1600],['design.logoDesktop','Logo Desktop',36,96],['design.logoMobile','Logo Mobile',32,72],['design.headerHeight','Tinggi Header',56,110],['design.sectionSpacing','Jarak Section',48,160],['design.menuColumns','Kolom Menu',1,4],['design.cardRadius','Radius Card',8,36]].map(x=>`<label><span class="text-[11px] font-semibold opacity-60">${x[1]}</span><input class="field mt-1" type="number" min="${x[2]}" max="${x[3]}" data-path="${x[0]}" value="${Number(getp(content,x[0]))}"></label>`).join('')}</div><div class="pt-4 border-t"><div class="serif text-[18px] font-bold">Navigasi</div><div class="mt-3 space-y-2">${content.nav.map((n,i)=>`<div class="grid grid-cols-[1fr_1fr_auto] gap-2"><input class="field nav" data-i="${i}" data-f="label" value="${esc(n.label)}"><input class="field nav" data-i="${i}" data-f="href" value="${esc(n.href)}"><button data-delnav="${i}" class="w-10 rounded-[10px] border text-red-600">✕</button></div>`).join('')}</div><button id="addNav" class="mt-3 text-[13px] font-semibold text-[var(--brown)]">+ Tambah navigasi</button></div></div>`;
 if(tab==='menu')return `<div><div class="flex justify-between items-center mb-4"><div class="serif text-[20px] font-bold">Menu & Semua Detail</div><button id="addItem" class="h-10 px-4 rounded-full bg-[var(--ink)] text-white text-[12px] font-semibold">+ Tambah Menu</button></div><div class="flex flex-wrap gap-2 mb-4">${content.menu.categories.map((c,i)=>`<div class="flex items-center gap-1 border rounded-full px-2 py-1 bg-white"><input data-cat="${i}" class="outline-none text-[12px] w-24" value="${esc(c)}"><button data-delcat="${i}" class="text-red-500">✕</button></div>`).join('')}</div><div class="space-y-4">${content.menu.items.map((m,i)=>`<div class="bg-white border rounded-[16px] p-4 grid md:grid-cols-[90px_1fr] gap-3"><img src="${esc(m.image||'')}" class="w-full h-20 object-cover rounded-[10px]"><div class="space-y-2"><div class="grid md:grid-cols-[1.4fr_1fr_1fr] gap-2"><input class="field item" data-i="${i}" data-f="name" value="${esc(m.name)}"><select class="field item" data-i="${i}" data-f="category">${content.menu.categories.map(c=>`<option ${c===m.category?'selected':''}>${esc(c)}</option>`).join('')}</select><input class="field item" data-i="${i}" data-f="price" type="number" value="${m.price}"></div><textarea class="field item" rows="2" data-i="${i}" data-f="desc">${esc(m.desc)}</textarea><div class="flex gap-2"><input class="field item flex-1" data-i="${i}" data-f="image" value="${esc(m.image||'')}"><input class="field item flex-1" data-i="${i}" data-f="badge" value="${esc(m.badge||'')}" placeholder="Badge"><button data-delitem="${i}" class="px-3 rounded-[10px] border text-red-600 text-[12px]">Hapus</button></div></div></div>`).join('')}</div></div>`;
 if(tab==='galeri')return `<div><div class="flex justify-between mb-4"><div class="serif text-[20px] font-bold">Galeri</div><button id="addGal" class="h-10 px-4 rounded-full bg-[var(--ink)] text-white text-[12px]">+ Tambah Foto</button></div><div class="grid md:grid-cols-3 gap-4">${content.gallery.map((g,i)=>`<div class="bg-white p-3 rounded-[16px] border"><img src="${esc(g)}" class="w-full aspect-square rounded-[10px] object-cover"><input class="field mt-2 gal" data-i="${i}" value="${esc(g)}"><button data-delgal="${i}" class="w-full h-9 mt-2 rounded-[10px] border text-red-600 text-[12px]">Hapus</button></div>`).join('')}</div></div>`;
 return `<div class="grid md:grid-cols-2 gap-3">${fields[tab].map(x=>inputFor(x[0],x[1])).join('')}${tab==='umum'?`<div class="md:col-span-2 pt-3 border-t"><label class="text-[11px] font-semibold opacity-60">Google Apps Script Web App URL</label><input class="field mt-1" data-path="app.scriptUrl" value="${esc(content.app.scriptUrl)}" placeholder="https://script.google.com/macros/s/.../exec"><p class="text-[11px] opacity-50 mt-1">Simpan URL ini agar Builder, Pemesanan, Kasir, dan website utama berbagi database Google Sheets.</p></div>`:''}</div>`;
}
function render(){document.getElementById('root').innerHTML=`<header class="sticky top-0 z-40 bg-white border-b"><div class="max-w-[1400px] mx-auto px-5 md:px-8 min-h-[68px] py-3 flex flex-wrap gap-3 items-center justify-between"><div class="flex gap-3 items-center">${logo(content)}<div><div class="serif font-bold">Website Builder</div><div class="text-[11px] opacity-50">${esc(content.brand.name)}</div></div></div><div class="flex gap-2 items-center"><span class="text-[11px] ${dirty?'text-[var(--brown)]':'opacity-60'}">${dirty?'Draft belum disimpan':syncState==='online'?'Tersimpan & online':'Tersimpan di perangkat'}</span><button id="testSync" class="h-9 px-3 rounded-full border text-[11px]">Cek Sinkron</button><button id="resetDraft" class="h-9 px-3 rounded-full border text-[11px]">Reset</button><button id="save" class="h-9 px-4 rounded-full bg-[var(--ink)] text-white text-[11px] font-semibold">Simpan</button></div></div></header><main class="max-w-[1400px] mx-auto px-5 md:px-8 py-6"><div class="flex flex-wrap gap-2 mb-6">${[['umum','Umum & Teks'],['tentang','Tentang'],['menu','Menu'],['galeri','Galeri'],['lokasi','Lokasi'],['tampilan','Tata Letak']].map(x=>`<button data-tab="${x[0]}" class="tab ${tab===x[0]?'active':'bg-white border'} h-10 px-5 rounded-full text-[12px] font-semibold">${x[1]}</button>`).join('')}</div><div class="grid xl:grid-cols-[1fr_420px] gap-6"><section class="bg-white rounded-[20px] border p-5 md:p-7">${tabView()}</section><aside class="space-y-4"><div class="bg-white rounded-[20px] border p-4"><div class="flex justify-between mb-3"><b class="serif">Preview Tersimpan</b></div>${preview(saved)}</div><div class="bg-white rounded-[20px] border-2 border-[var(--brown)]/30 p-4"><div class="flex justify-between mb-3"><b class="serif">Preview Draft</b><span class="text-[10px] opacity-50">${dirty?'belum disimpan':'sinkron'}</span></div>${preview(content)}</div></aside></div></main>`;bind()}
function bind(){
 document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{tab=b.dataset.tab;render()});
 document.querySelectorAll('[data-path]').forEach(e=>e.oninput=()=>{setp(content,e.dataset.path,e.type==='number'?Number(e.value)||0:e.value);updatePreview()});
 document.querySelectorAll('.nav').forEach(e=>e.oninput=()=>{content.nav[e.dataset.i][e.dataset.f]=e.value;dirty=true});
 document.querySelectorAll('[data-cat]').forEach(e=>e.oninput=()=>{content.menu.categories[e.dataset.cat]=e.value;dirty=true});
 document.querySelectorAll('.item').forEach(e=>e.oninput=()=>{const i=+e.dataset.i,f=e.dataset.f;content.menu.items[i][f]=f==='price'?Number(e.value)||0:e.value;dirty=true});
 document.querySelectorAll('.gal').forEach(e=>e.oninput=()=>{content.gallery[e.dataset.i]=e.value;dirty=true});
 document.querySelectorAll('[data-delnav]').forEach(b=>b.onclick=()=>{content.nav.splice(+b.dataset.delnav,1);dirty=true;render()});
 document.querySelectorAll('[data-delitem]').forEach(b=>b.onclick=()=>{content.menu.items.splice(+b.dataset.delitem,1);dirty=true;render()});
 document.querySelectorAll('[data-delgal]').forEach(b=>b.onclick=()=>{content.gallery.splice(+b.dataset.delgal,1);dirty=true;render()});
 document.querySelectorAll('[data-delcat]').forEach(b=>b.onclick=()=>{const i=+b.dataset.delcat,cat=content.menu.categories[i];content.menu.items=content.menu.items.filter(x=>x.category!==cat);content.menu.categories.splice(i,1);dirty=true;render()});
 document.getElementById('addNav')?.addEventListener('click',()=>{content.nav.push({label:'Navigasi Baru',href:'#menu'});dirty=true;render()});
 document.getElementById('addItem')?.addEventListener('click',()=>{content.menu.items.push({id:uid('M-'),category:content.menu.categories[0]||'KOPI',name:'Menu Baru',price:0,desc:'',image:'',badge:''});dirty=true;render()});
 document.getElementById('addGal')?.addEventListener('click',()=>{content.gallery.push('');dirty=true;render()});
 document.getElementById('testSync')?.addEventListener('click',async()=>{syncState=await syncStatus();render()});
 document.getElementById('save')?.addEventListener('click',async()=>{localStorage.setItem('osbone_app_script_url',content.app?.scriptUrl||'');const r=await saveContent(content);saved=clone(content);dirty=false;syncState=r.ok?'online':(r.offline?'offline':'error');alert(r.ok?'Perubahan tersimpan dan tersinkron ke Google Sheets.':r.offline?'Perubahan tersimpan di perangkat. Isi Web App URL untuk sinkron online.':'Perubahan tersimpan di perangkat, tetapi sinkron online gagal. Periksa URL/deployment Apps Script.');render()});
 document.getElementById('resetDraft')?.addEventListener('click',()=>{content=clone(saved);dirty=false;render()});
}
function updatePreview(){const p=document.querySelector('aside');if(p)p.innerHTML=`<div class="bg-white rounded-[20px] border p-4"><div class="flex justify-between mb-3"><b class="serif">Preview Tersimpan</b></div>${preview(saved)}</div><div class="mt-4 bg-white rounded-[20px] border-2 border-[var(--brown)]/30 p-4"><div class="flex justify-between mb-3"><b class="serif">Preview Draft</b><span class="text-[10px] text-[var(--brown)]">belum disimpan</span></div>${preview(content)}</div>`}
(async()=>{content=await loadContent();saved=clone(content);window.APP_SCRIPT_URL=content.app?.scriptUrl||localStorage.getItem('osbone_app_script_url')||'';syncState=await syncStatus();render()})();
</script></body></html>
